{
    "private": true,
    "author": "Aylur",
    "license": "MIT",
    "repository": "github:Aylur/girgen",
    "funding": {
        "type": "kofi",
        "url": "https://ko-fi.com/aylur"
    },
    "scripts": {
        "build": "cargo build --release --target x86_64-unknown-linux-musl && cp target/x86_64-unknown-linux-musl/release/girgen packages/linux-x64/girgen",
        "girs": "flatpak run --command=cp --filesystem=home org.gnome.Sdk -r /usr/share/gir-1.0 gir-1.0"
    },
    "prettier": {
        "semi": false,
        "tabWidth": 4,
        "printWidth": 80,
        "overrides": [
            {
                "files": "**/*.md",
                "options": {
                    "tabWidth": 2,
                    "printWidth": 80,
                    "proseWrap": "always"
                }
            }
        ]
    }
}
